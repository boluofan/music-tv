<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_app_gradient">

    <!-- Left Panel: Branding -->
    <LinearLayout
        android:id="@+id/panelLeft"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="48dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintWidth_percent="0.42"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <ImageView
            android:layout_width="96dp"
            android:layout_height="96dp"
            android:src="@drawable/ic_logo"
            android:contentDescription="Logo"
            android:layout_marginBottom="24dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="菠萝音乐"
            android:textColor="#FFFFFF"
            android:textSize="40sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="洛雪音乐 TV 客户端"
            android:textColor="#9CA3AF"
            android:textSize="16sp"
            android:gravity="center"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="连接 lxserver 洛雪音乐服务"
            android:textColor="#6B7280"
            android:textSize="14sp"
            android:gravity="center"
            android:layout_marginBottom="40dp" />

        <!-- Mode Toggle Button -->
        <Button
            android:id="@+id/btnToggleMode"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="扫码配置"
            android:textColor="#FFFFFF"
            android:background="@drawable/bg_btn_primary"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:focusable="true"
            android:nextFocusRight="@+id/etUrl" />

        <!-- Help Text -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="如何获取服务器地址？\n请运行 lxserver 服务，在控制台查看地址"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:gravity="start"
            android:layout_marginTop="24dp"
            android:layout_marginBottom="4dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="如何获取账号密码？\n在 lxserver 的[管理控制台]中配置用户"
            android:textColor="#6B7280"
            android:textSize="12sp"
            android:gravity="start" />

    </LinearLayout>

    <!-- Divider -->
    <View
        android:id="@+id/divider"
        android:layout_width="1dp"
        android:layout_height="0dp"
        android:background="#2D2D54"
        android:layout_marginTop="48dp"
        android:layout_marginBottom="48dp"
        app:layout_constraintStart_toEndOf="@+id/panelLeft"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent" />

    <!-- Right Panel: Form -->
    <ScrollView
        android:id="@+id/panelRight"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        android:paddingStart="56dp"
        android:paddingEnd="56dp"
        android:paddingTop="32dp"
        android:paddingBottom="32dp"
        app:layout_constraintStart_toEndOf="@+id/divider"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

        <!-- Manual Login Container -->
        <LinearLayout
            android:id="@+id/layoutManual"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="visible">

            <!-- API Type -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="API 类型"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <RadioGroup
                android:id="@+id/rgApiType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp"
                android:descendantFocusability="afterDescendants">

                <RadioButton
                    android:id="@+id/rbLxserver"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="lxserver"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#6366F1"
                    android:checked="true"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusDown="@+id/etUrl"
                    android:nextFocusUp="@+id/btnToggleMode"
                    android:nextFocusLeft="@+id/btnToggleMode"
                    android:nextFocusRight="@+id/rbMiMusic" />

                <Space
                    android:layout_width="12dp"
                    android:layout_height="40dp" />

                <RadioButton
                    android:id="@+id/rbMiMusic"
                    android:layout_width="0dp"
                    android:layout_height="40dp"
                    android:layout_weight="1"
                    android:text="MiMusic"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:buttonTint="#6366F1"
                    android:gravity="center"
                    android:background="@drawable/bg_input_field"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:clickable="true"
                    android:nextFocusDown="@+id/etUrl"
                    android:nextFocusUp="@+id/btnToggleMode"
                    android:nextFocusLeft="@+id/rbLxserver"
                    android:nextFocusRight="@+id/btnConnect" />

            </RadioGroup>

            <!-- Server URL -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="服务地址"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etUrl"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="http://localhost:9527"
                android:inputType="textUri"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B5563"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/etUsername"
                android:nextFocusUp="@+id/rbLxserver"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/etUsername"
                android:layout_marginBottom="8dp" />

            <!-- Username -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lxserver 用户名"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etUsername"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="请输入用户名"
                android:inputType="textPersonName"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B5563"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/etPassword"
                android:nextFocusUp="@+id/etUrl"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/etPassword"
                android:layout_marginBottom="8dp" />

            <!-- Password -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="lxserver 密码"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etPassword"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="Password"
                android:inputType="textPassword"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B5563"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionNext"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/etToken"
                android:nextFocusUp="@+id/etUsername"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/btnConnect"
                android:layout_marginBottom="8dp" />

            <!-- Token -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="用户 Token (选填)"
                android:textColor="#9CA3AF"
                android:textSize="13sp"
                android:layout_marginBottom="4dp" />

            <EditText
                android:id="@+id/etToken"
                android:layout_width="match_parent"
                android:layout_height="44dp"
                android:background="@drawable/bg_input_field"
                android:hint="请输入用户 Token"
                android:inputType="text"
                android:paddingStart="16dp"
                android:paddingEnd="16dp"
                android:textColor="#FFFFFF"
                android:textColorHint="#4B5563"
                android:textSize="15sp"
                android:singleLine="true"
                android:imeOptions="actionDone"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/btnConnect"
                android:nextFocusUp="@+id/etPassword"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/btnConnect" />

            <!-- Connect Button -->
            <Button
                android:id="@+id/btnConnect"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:layout_marginTop="32dp"
                android:background="@drawable/bg_btn_primary"
                android:text="连接 lxserver"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"
                android:stateListAnimator="@null"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:nextFocusDown="@+id/rbLxserver"
                android:nextFocusUp="@+id/etToken"
                android:nextFocusLeft="@+id/btnToggleMode"
                android:nextFocusRight="@+id/btnConnect" />

        </LinearLayout>

        <!-- QR Login Container -->
        <LinearLayout
            android:id="@+id/layoutQr"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center"
            android:visibility="gone">

            <FrameLayout
                android:layout_width="240dp"
                android:layout_height="240dp"
                android:background="@drawable/bg_input_field"
                android:padding="12dp">

                <ImageView
                    android:id="@+id/ivQrCode"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="fitCenter" />
            </FrameLayout>

            <TextView
                android:id="@+id/tvScanHint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="手机扫码配置服务器"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:layout_marginTop="24dp" />

            <TextView
                android:id="@+id/tvIpAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="正在获取地址..."
                android:textColor="#9CA3AF"
                android:textSize="14sp"
                android:layout_marginTop="8dp" />

        </LinearLayout>

        </LinearLayout>

    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>
